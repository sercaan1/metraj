# ===========================================
# Steel Takeoff API Configuration
# ===========================================

PYTHONPATH=.

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ===========================================
# JWT Settings - MUST MATCH YOUR .NET CRM!
# ===========================================
# Copy the exact same key from your .NET appsettings.json
# This is the ONLY thing you need to configure for auth to work

JWT_SECRET_KEY=your-secret-key-from-dotnet-appsettings-minimum-32-chars
JWT_ALGORITHM=HS256

# Example - your .NET appsettings.json should have:
# {
#   "Jwt": {
#     "Key": "your-secret-key-from-dotnet-appsettings-minimum-32-chars"
#   }
# }
