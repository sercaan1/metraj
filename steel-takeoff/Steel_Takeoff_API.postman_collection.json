{
	"info": {
		"_postman_id": "steel-takeoff-api",
		"name": "Steel Takeoff API",
		"description": "API for extracting rebar quantities from DXF construction drawings.\n\nNOTE: This API validates JWT tokens from your .NET CRM. Set your token in the 'token' collection variable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "PASTE_YOUR_CRM_TOKEN_HERE",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health & Info",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					}
				},
				{
					"name": "API Root",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				}
			]
		},
		{
			"name": "Authentication",
			"description": "Token validation endpoints. Tokens are generated by your .NET CRM.",
			"item": [
				{
					"name": "Validate Token",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "validate"]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Analysis",
			"item": [
				{
					"name": "Analyze DXF File",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": ""
								},
								{
									"key": "analyze_poz_blocks",
									"value": "true",
									"type": "text"
								},
								{
									"key": "analyze_text_annotations",
									"value": "true",
									"type": "text"
								},
								{
									"key": "analyze_geometry",
									"value": "false",
									"type": "text"
								},
								{
									"key": "merge_duplicates",
									"value": "true",
									"type": "text"
								},
								{
									"key": "export_excel",
									"value": "true",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/analysis/analyze",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "analysis", "analyze"]
						}
					}
				},
				{
					"name": "Get File Info",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/analysis/info",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "analysis", "info"]
						}
					}
				},
				{
					"name": "Analyze and Download Excel",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/analysis/export/excel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "analysis", "export", "excel"]
						}
					}
				},
				{
					"name": "Download Excel by Job ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/analysis/download/:job_id/excel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "analysis", "download", ":job_id", "excel"],
							"variable": [
								{
									"key": "job_id",
									"value": "abc12345"
								}
							]
						}
					}
				}
			]
		}
	]
}
